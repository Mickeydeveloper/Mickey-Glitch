# Mickey Glitch Bot - Environment Configuration
# Set LOG_LEVEL to control logging verbosity

# Logging Level: 'error', 'warn', 'info', 'debug'
# Set to 'warn' or 'error' to suppress session decryption messages
LOG_LEVEL=warn

# Bot Settings
OWNER_NUMBER=255615858685

# Session Settings (auto-regenerates after fix-session.js)
SESSION_FILE_PATH=./session

# API Keys
GIPHY_API_KEY=your-giphy-api-key
ACRCLOUD_ACCESS_KEY=your-acrcloud-access-key
ACRCLOUD_ACCESS_SECRET=your-acrcloud-access-secret
AZAM_CLIENT_ID=your-azampay-client-id
AZAM_CLIENT_SECRET=your-azampay-client-secret

# Cache Settings
STORE_WRITE_INTERVAL=10000

# Memory Management
GC_INTERVAL=30000
MAX_MEMORY_MB=450
